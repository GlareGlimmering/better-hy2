[Unit]
Description=Better HY2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/local/h-ui/
Environment=HUI_DATA=/usr/local/h-ui/
Environment=GIN_MODE=release
ExecStart=/usr/local/h-ui/h-ui -p 8000
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
